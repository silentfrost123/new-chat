# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Vellum

# Database (SQLite for local; use postgres:// for production)
DATABASE_URL=file:./data/vellum.db

# Auth
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# AI Providers (leave empty to use MOCK_AI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MOCK_AI=true

# Redis (optional)
REDIS_URL=

# Object Storage (optional — falls back to local /public/uploads)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Admin seed
ADMIN_EMAIL=admin@vellum.app
ADMIN_PASSWORD=admin123456
